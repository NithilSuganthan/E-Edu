# ==============================================
# Inventobots Academy — Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ==============================================

# --- Application Settings ---

# Debug mode (True for development, False for production)
DEBUG=True

# Django secret key (MUST be changed in production)
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF (production only, include scheme)
# Example: https://inventobots-demo.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Admin Panel ---

# Custom URL path for the admin panel (security measure)
ADMIN_URL=super_secure_admin/

# --- Database (PostgreSQL) ---

# Option 1: Full connection URL (used by Render, Neon, Railway, etc.)
# When set, it takes priority over the individual settings below.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSLMODE=require

# Option 2: Individual settings (local development)
DB_NAME=inventobots_db
DB_USER=inventobots_user
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Payments (Razorpay) ---
# Test keys are enough for a demo; without them the "Pay Now" flow shows an error.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Google Sign-In (django-allauth) ---
# Optional. Without these, the Google button on /parents/login/ will not work;
# username/password login is unaffected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
